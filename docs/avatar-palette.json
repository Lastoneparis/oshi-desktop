{
  "_comment": "Default-avatar palette for picture-less contacts and groups. ONE spec for iOS/Mac Catalyst (OSHI/AvatarIdentity.swift), Android (OSHI-Android/.../ui/theme/AvatarIdentity.kt) and desktop (OSHI-Desktop/.../ui/OshiTheme.kt). Each platform carries the literals and its tests re-read THIS file: palette values, contrast and the identifier->slot vectors. Change it here first, then all three, or a contact changes colour when they change device.",
  "version": 2,
  "selection": {
    "normalise": "trim; if the result is a UUID (8-4-4-4-12 hex) lowercase it, otherwise use the identifier unchanged (contacts: the canonical, standard padded base64 public key)",
    "hash": "SHA-256 over the UTF-8 bytes of the normalised identifier",
    "slot": "digest[0] mod 16"
  },
  "gradient": {
    "type": "linear",
    "angleDegrees": 135,
    "from": "top-leading corner (start)",
    "to": "bottom-trailing corner (end)",
    "interpolation": "sRGB"
  },
  "highlight": {
    "type": "radial",
    "color": "#FFFFFF",
    "centerX": 0.3,
    "centerY": 0.2,
    "radius": 0.8,
    "alphaAtCenter": 0.24,
    "alphaAtRadius": 0.0,
    "units": "fractions of the avatar diameter, origin top-leading",
    "purpose": "soft light blob baked into the fill; drawn over the gradient, clipped to the circle"
  },
  "contrast": {
    "minimum": 3.0,
    "rule": "WCAG 2.1 contrast of `ink` against start, end, and the centre colour = mix(mix(start,end,0.5), white, highlight alpha at (0.5,0.5)) — initials are large text (>= 3:1)"
  },
